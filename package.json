{
  "name": "slash",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "node scripts/electron-dev.mjs",
    "dev:web": "node scripts/copy-emoji.mjs && next dev --port 3210",
    "predev": "node scripts/copy-emoji.mjs",
    "build": "node scripts/copy-emoji.mjs && next build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win --publish never",
    "release": "npm run build && electron-builder --win --publish always",
    "lint": "eslint",
    "icon": "node scripts/make-icon.mjs"
  },
  "devDependencies": {
    "@blocknote/core": "^0.56.0",
    "@blocknote/mantine": "^0.56.0",
    "@blocknote/react": "^0.56.0",
    "@mantine/core": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "clsx": "^2.1.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "emoji-datasource-apple": "^16.0.0",
    "emoji-picker-react": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "lucide-react": "^1.61.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "zustand": "^5.0.16"
  },
  "description": "Slash — espaço de trabalho no estilo Notion",
  "author": "Slash",
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.slash.desktop",
    "productName": "Slash",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "out/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Slash-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "VitorFalcochio",
        "repo": "slash",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
